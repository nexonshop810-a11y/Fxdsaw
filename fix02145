local function spamAttack(targetPart)
    local remote = getAnyDragonRemote()
    if not remote then return false end
    
    local health = targetPart:FindFirstChild("Health")
    if not health then return false end

    while health and health.Value > 0 and targetPart.Parent do
        pcall(function()
            local args = {"Breath", "Destructibles", targetPart}
            remote:FireServer(unpack(args))
        end)
        task.wait(CONFIG.ATTACK_DELAY)
    end
    return true
end

--// 🍎 FOOD NODE FUNCTIONS
local function getAllAliveNodes()
    if not FoodFolder then return {} end
    
    local aliveNodes = {}
    for _, subFolder in pairs(FoodFolder:GetChildren()) do
        for _, node in pairs(subFolder:GetDescendants()) do
            pcall(function()
                if node:FindFirstChild("Health") and node.Health.Value > 0 then
                    table.insert(aliveNodes, node)
                end
            end)
        end
    end
    return aliveNodes
end

local function collectNearbyFoods()
    pcall(function()
        for _, obj in pairs(workspace.Camera:GetChildren()) do
            for _, name in ipairs(CollectableNames) do
                if obj.Name == name then
                    for _, part in pairs(obj:GetDescendants()) do
                        if part:IsA("BasePart") and hrp then
                            part.CFrame = hrp.CFrame
                        end
                    end
                end
            end
        end
    end)
end

local function getClosestAliveNode()
    local aliveNodes = getAllAliveNodes()
    local closestNode, closestDist = nil, math.huge

    for _, node in ipairs(aliveNodes) do
        pcall(function()
            if node and node.Parent and hrp then
                local part = node:IsA("BasePart") and node or node:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local dist = (hrp.Position - part.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestNode = node
                    end
                end
            end
        end)
    end

    return closestNode
end

local function getNodeBasePart(node)
    if not node then return nil end
    if node:IsA("BasePart") then return node end
    if node:IsA("Model") then
        return node.PrimaryPart or node:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function startAutoFarm()
    task.spawn(function()
        while true do
            pcall(function()
                local node = getClosestAliveNode()
                local base = getNodeBasePart(node)

                if node and base and hrp then
                    print("🌳 พบต้นไม้:", node.Name)
                    hrp.CFrame = base.CFrame + Vector3.new(0, 4, 0)
                    task.wait(2)
                    spamAttack(base)
                else
                    warn("⚠️ ไม่พบต้นไม้ → patrol")
                    for _, pos in ipairs(PATROL_POSITIONS) do
                        if hrp then hrp.CFrame = CFrame.new(pos) end
                        task.wait(CONFIG.MOVEMENT_SPEED)
                        
                        local found = getClosestAliveNode()
                        if found then break end
                    end
                end
            end)
            task.wait(1)
        end
    end)
end

local function startAutoCollect()
    task.spawn(function()
        while task.wait(1) do
            collectNearbyFoods()
        end
    end)
end

