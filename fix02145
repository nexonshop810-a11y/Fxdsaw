            corner.CornerRadius = UDim.new(0, 12)
            corner.Parent = coinLabel

            task.spawn(function()
                while task.wait(CONFIG.GUI_UPDATE_RATE) do
                    pcall(function()
                        local data = player:FindFirstChild("Data")
                        if data then
                            local currency = data:FindFirstChild("Currency")
                            if currency then
                                local coins = currency:FindFirstChild("Coins")
                                if coins then
                                    coinLabel.Text = string.format("💰 %s", tostring(coins.Value))
                                end
                            end
                        end
                    end)
                end
            end)
        end

        -- 🍎 Fruit Display
        if CONFIG.SHOW_FRUIT_GUI then
            local fruitFrame = Instance.new("Frame")
            fruitFrame.Name = "FruitFrame"
            fruitFrame.Size = UDim2.new(0, 300, 0, 180)
            fruitFrame.Position = UDim2.new(0.5, -150, 0.15, 0)
            fruitFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            fruitFrame.BackgroundTransparency = 0.3
            fruitFrame.BorderSizePixel = 0
            fruitFrame.Parent = screenGui

            local frameCorner = Instance.new("UICorner")
            frameCorner.CornerRadius = UDim.new(0, 12)
            frameCorner.Parent = fruitFrame

            -- Title
            local title = Instance.new("TextLabel")
            title.Size = UDim2.new(1, 0, 0, 35)
            title.Position = UDim2.new(0, 0, 0, 0)
            title.BackgroundTransparency = 1
            title.Text = "🌟 INVENTORY 🌟"
            title.TextColor3 = Color3.fromRGB(255, 255, 255)
            title.Font = Enum.Font.GothamBold
            title.TextSize = 18
            title.Parent = fruitFrame

            local fruits = {
                {name = "Edamame", icon = "🫘", color = Color3.fromRGB(144, 238, 144)},
                {name = "KajiFruit", icon = "🍊", color = Color3.fromRGB(255, 165, 0)},
                {name = "MistSudachi", icon = "🍋", color = Color3.fromRGB(255, 255, 102)}
            }

            for i, fruit in ipairs(fruits) do
                local label = Instance.new("TextLabel")
                label.Name = fruit.name .. "Label"
                label.Size = UDim2.new(1, -20, 0, 40)
                label.Position = UDim2.new(0, 10, 0, 35 + (i-1) * 45)
                label.BackgroundTransparency = 1
                label.TextColor3 = fruit.color
                label.TextStrokeTransparency = 0.5
                label.TextScaled = true
                label.Font = Enum.Font.GothamBold
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.Text = fruit.icon .. " Loading..."
                label.Parent = fruitFrame
            end

            task.spawn(function()
                while task.wait(CONFIG.GUI_UPDATE_RATE) do
                    pcall(function()
                        local data = player:FindFirstChild("Data")
                        if not data then return end
                        
                        local resources = data:FindFirstChild("Resources")
                        if not resources then return end
                        
                        for i, fruit in ipairs(fruits) do
                            local val = resources:FindFirstChild(fruit.name)
                            if val then
                                local label = fruitFrame:FindFirstChild(fruit.name .. "Label")
                                if label then
                                    local amount = val.Value
                                    local percentage = math.floor((amount / CONFIG.SELL_THRESHOLD) * 100)
                                    label.Text = string.format("%s %s: %d (%d%%)", 
                                        fruit.icon, fruit.name, amount, percentage)
                                    
                                    -- เปลี่ยนสีตามเปอร์เซ็นต์
                                    if percentage >= 100 then
                                        label.TextColor3 = Color3.fromRGB(0, 255, 0) -- เขียว (พร้อมขาย)
                                    elseif percentage >= 50 then
                                        label.TextColor3 = Color3.fromRGB(255, 255, 0) -- เหลือง
                                    else
                                        label.TextColor3 = fruit.color -- สีปกติ
                                    end
                                end
                            end
                        end
                    end)
                end
            end)
        end
    end)
end

--// 🔄 ANTI-AFK
local function startAntiAFK()
    task.spawn(function()
        local VIM = game:GetService("VirtualInputManager")
        while true do
            task.wait(180)
            pcall(function()
                VIM:SendKeyEvent(true, Enum.KeyCode.A, false, game)
                task.wait(0.1)
                VIM:SendKeyEvent(false, Enum.KeyCode.A, false, game)
            end)
        end
    end)
end

--// ⏱️ AUTO RETURN FROM SELL WORLD
local function autoReturnFromSellWorld()
    task.spawn(function()
        local timeInSell = 0
        
        while true do
            task.wait(1)
            
            pcall(function()
                local currentPlace = game.PlaceId
                
                if currentPlace == SELL_WORLD then
                    timeInSell += 1
                    print("⏱️ อยู่ SELL WORLD:", timeInSell, "วินาที")
                    
                    if timeInSell >= 25 then
                        warn("⚠️ อยู่ SELL WORLD นานเกิน → วาร์ปกลับ!")
                        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                        if remotes then
                            local tpRemote = remotes:FindFirstChild("WorldTeleportRemote")
                            if tpRemote then
                                tpRemote:InvokeServer(FARM_WORLD, {})
                            end
                        end
                        timeInSell = 0
                    end
                else
                    timeInSell = 0
                end
            end)
        end
    end)
end

