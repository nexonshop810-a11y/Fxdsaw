--// 🔧 ลบโมเดลตกแต่ง / พื้นผิว / เอฟเฟกต์ในเกม (ช่วยเพิ่ม FPS แบบปลอดภัย)
local function cleanVisualObjects()
    local removed = 0
    local protectedFolders = {
        game:GetService("Players"),
        game:GetService("ReplicatedStorage"),
        game:GetService("Lighting"),
        workspace:FindFirstChild("Interactions"),
        workspace:FindFirstChild("ActiveRooms"),
        workspace:FindFirstChild("Camera")
    }

    local function isProtected(obj)
        for _, folder in ipairs(protectedFolders) do
            if folder and obj:IsDescendantOf(folder) then
                return true
            end
        end
        return false
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if isProtected(obj) then continue end  -- 🚫 ข้ามโฟลเดอร์สำคัญ

        -- ลบ Texture / Decal / Surface
        if obj:IsA("Texture") or obj:IsA("Decal") or obj:IsA("SurfaceAppearance") then
            pcall(function()
                obj:Destroy()
                removed += 1
            end)
        end

        -- ลบพวก Prop ปลอม เช่น Tree, Rock, Grass, Bush
        if obj:IsA("Model") or obj:IsA("Folder") then
            local name = obj.Name:lower()
            if name:find("tree") or name:find("bush") or name:find("grass") or name:find("leaf")
                or name:find("rock") or name:find("plant") or name:find("prop")
                or name:find("decoration") or name:find("fake") then
                pcall(function()
                    obj:Destroy()
                    removed += 1
                end)
            end
        end

        -- ปิด Particle / Smoke / Fire / Trail
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") then
            pcall(function()
                obj.Enabled = false
                removed += 1
            end)
        end
    end

    print(("🧹 ลบพื้นผิว / ต้นไม้ / เอฟเฟกต์ ออกทั้งหมด %d รายการ (ปลอดภัย)") :format(removed))
end


local function getClosestAliveNode()
    local aliveNodes = getAllAliveNodes()
    local closestNode = nil
    local closestDist = math.huge

    for _, node in ipairs(aliveNodes) do
        if node and node.Parent then
            local part = node:IsA("BasePart") and node or node:FindFirstChildWhichIsA("BasePart", true)
            if part then
                local dist = (hrp.Position - part.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestNode = node
                end
            end
        end
    end

    return closestNode
end
local function getNodeBasePart(node)
    if not node then return nil end

    if node:IsA("BasePart") then
        return node
    end

    if node:IsA("Model") then
        if node.PrimaryPart then return node.PrimaryPart end
        
        local part = node:FindFirstChildWhichIsA("BasePart", true)
        if part then return part end
    end

    return nil
end
    

local function startAutoFarm()
    task.spawn(function()
        local retryCount = 0

        while true do
            local node = getClosestAliveNode()
            local base = getNodeBasePart(node)

            if node and base and node:FindFirstChild("Health") and node.Health.Value > 0 then
                retryCount = 0

                -- 🌳 แสดงต้นไม้ที่เจอ
                print("🌳 พบต้นไม้ใกล้สุด:", node.Name)

                -- ✅ วาร์ปก่อน
                hrp.CFrame = base.CFrame + Vector3.new(0, 4, 0)

                -- ⏳ รอ 2 วินาทีเพื่อให้ต้นไม้โหลดสมบูรณ์
                task.wait(2)

                -- 🔥 โจมตีต้นไม้
                spamAttack(base)

            else
                retryCount += 1
                warn(("⚠️ ไม่พบต้นไม้รอบที่ %d → ตรวจสอบใหม่..."):format(retryCount))
                task.wait(1)

                -- 🟢 ลองค้นหาใหม่อีกรอบ
                local newNode = getClosestAliveNode()
                local newBase = getNodeBasePart(newNode)

                if newNode and newBase then
                    print("✅ เจอต้นไม้ใหม่แล้ว:", newNode.Name)

                    -- วาร์ป → รอ 2 วิ
                    hrp.CFrame = newBase.CFrame + Vector3.new(0, 4, 0)
                    task.wait(2)

                    spamAttack(newBase)
                else
                    -- ❌ ไม่เจอ → เดิน patrol
                    warn("🚶 กำลังเดินตรวจหาตำแหน่งต้นไม้...")

                    for _, pos in ipairs(PATROL_POSITIONS) do
                        hrp.CFrame = CFrame.new(pos)
                        task.wait(CONFIG.MOVEMENT_SPEED)

                        local found = getClosestAliveNode()
                        local fbase = getNodeBasePart(found)

                        if found and fbase then
                            print("🌲 เจอต้นไม้ใหม่ตอน patrol:", found.Name)

                            -- วาร์ปก่อน แล้วรอให้โหลด
                            hrp.CFrame = fbase.CFrame + Vector3.new(0, 4, 0)
                            task.wait(2)

                            spamAttack(fbase)
                            break
                        end
                    end
                end
            end

            task.wait(1)
        end
    end)
end



