        fruitFrame.Name = "FruitFrame"
        fruitFrame.Size = UDim2.new(0, 280, 0, 150)
        fruitFrame.Position = UDim2.new(0.5, -140, 0.15, 0)
        fruitFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
