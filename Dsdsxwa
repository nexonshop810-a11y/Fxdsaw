--// 🔧 ลบโมเดลตกแต่ง / พื้นผิว / เอฟเฟกต์ในเกม (ช่วยเพิ่ม FPS แบบปลอดภัย)
local function cleanVisualObjects()
    local removed = 0
    local protectedFolders = {
        game:GetService("Players"),
        game:GetService("ReplicatedStorage"),
        game:GetService("Lighting"),
        workspace:FindFirstChild("Interactions"),
        workspace:FindFirstChild("ActiveRooms"),
        workspace:FindFirstChild("Camera")
    }

    local function isProtected(obj)
        for _, folder in ipairs(protectedFolders) do
            if folder and obj:IsDescendantOf(folder) then
                return true
            end
        end
        return false
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if isProtected(obj) then continue end  -- 🚫 ข้ามโฟลเดอร์สำคัญ

        -- ลบ Texture / Decal / Surface
        if obj:IsA("Texture") or obj:IsA("Decal") or obj:IsA("SurfaceAppearance") then
            pcall(function()
                obj:Destroy()
                removed += 1
            end)
        end

        -- ลบพวก Prop ปลอม เช่น Tree, Rock, Grass, Bush
        if obj:IsA("Model") or obj:IsA("Folder") then
            local name = obj.Name:lower()
            if name:find("tree") or name:find("bush") or name:find("grass") or name:find("leaf")
                or name:find("rock") or name:find("plant") or name:find("prop")
                or name:find("decoration") or name:find("fake") then
                pcall(function()
                    obj:Destroy()
                    removed += 1
                end)
            end
        end

        -- ปิด Particle / Smoke / Fire / Trail
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") then
            pcall(function()
                obj.Enabled = false
                removed += 1
            end)
        end
    end

    print(("🧹 ลบพื้นผิว / ต้นไม้ / เอฟเฟกต์ ออกทั้งหมด %d รายการ (ปลอดภัย)") :format(removed))
end




-- 🌳 ระบบค้นหาต้นไม้แบบเข้มข้น (Advanced Tree Pathfinding)
-- วางโค้ดนี้แทนที่ฟังก์ชัน getAllAliveNodes และ getClosestAliveNode เดิม

--// 📊 ตัวแปรสถิติการค้นหา
local SearchStats = {
    totalSearches = 0,
    treesFound = 0,
    lastSearchTime = 0,
    searchMode = "NORMAL" -- NORMAL, DEEP, ULTRA
}

--// 🔍 ฟังก์ชันค้นหาต้นไม้แบบละเอียด (DEEP SEARCH)
local function deepSearchNodes()
    local aliveNodes = {}
    local searchedObjects = 0
    
    if not FoodFolder then 
        warn("⚠️ FoodFolder is nil - ข้ามการค้นหา")
        return aliveNodes 
    end
    
    -- 🔎 ค้นหาแบบละเอียดทุกชั้น
    for _, subFolder in pairs(FoodFolder:GetChildren()) do
        for _, obj in pairs(subFolder:GetDescendants()) do
            searchedObjects = searchedObjects + 1
            
            -- ตรวจสอบเงื่อนไขหลายแบบ
            local isValidNode = false
            local healthObj = obj:FindFirstChild("Health")
            
            if healthObj and healthObj.Value > 0 then
                -- เช็คชื่อที่เกี่ยวข้องกับต้นไม้/ผลไม้
                local name = obj.Name:lower()
                if name:find("billboard") or name:find("trunk") or name:find("tree") 
                   or name:find("food") or name:find("node") or name:find("fruit") then
                    isValidNode = true
                end
                
                -- เช็คประเภท Part
                if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
                    isValidNode = true
                end
            end
            
            if isValidNode then
                table.insert(aliveNodes, obj)
            end
        end
    end
    
    print(("🔍 Deep Search: ตรวจสอบ %d objects → พบต้นไม้ %d ต้น"):format(searchedObjects, #aliveNodes))
    return aliveNodes
end

--// 🌐 ฟังก์ชันค้นหาต้นไม้แบบสุดเข้มข้น (ULTRA SEARCH)
local function ultraSearchNodes()
    local aliveNodes = {}
    local searchZones = {}
    
    if not FoodFolder then return aliveNodes end
    
    -- 📍 สร้างโซนค้นหาจากตำแหน่งปัจจุบัน
    local currentPos = hrp.Position
    local searchRadius = 500 -- รัศมีค้นหา 500 studs
    

    
    -- วนหาทุก Object ใน Workspace.Camera (ของที่เก็บได้)
    for _, obj in pairs(workspace.Camera:GetDescendants()) do
        if obj:IsA("BasePart") and obj:FindFirstChild("Health") then
            local dist = (obj.Position - currentPos).Magnitude
            if dist <= searchRadius then
                table.insert(aliveNodes, obj)
            end
        end
    end
    
    -- วนหาใน FoodFolder ทุก Descendant
    for _, obj in pairs(FoodFolder:GetDescendants()) do
        if obj:FindFirstChild("Health") and obj.Health.Value > 0 then
            local dist = (obj.Position - currentPos).Magnitude
            if dist <= searchRadius then
                -- ตรวจซ้ำ
                local exists = false
                for _, node in pairs(aliveNodes) do
                    if node == obj then
                        exists = true
                        break
                    end
                end
                if not exists then
                    table.insert(aliveNodes, obj)
                end
            end
        end
    end
    

    return aliveNodes
end

--// 🎯 ฟังก์ชันค้นหาต้นไม้แบบอัจฉริยะ (Smart Search)
local function smartSearchNodes()
    local nodes = {}
    
    -- เริ่มด้วย Normal Search
    for _, subFolder in pairs(FoodFolder:GetChildren()) do
        for _, node in pairs(subFolder:GetDescendants()) do
            if (node.Name:lower():find("billboard") or node.Name:lower():find("trunk") or node:IsA("BasePart"))
               and node:FindFirstChild("Health") and node.Health.Value > 0 then
                table.insert(nodes, node)
            end
        end
    end
    
    -- ถ้าไม่เจอ → ลอง Deep Search
    if #nodes == 0 then
        warn("⚠️ Normal Search ไม่เจอ → เปลี่ยนเป็น Deep Search")
        SearchStats.searchMode = "DEEP"
        nodes = deepSearchNodes()
    end
    
    -- ถ้ายังไม่เจอ → ลอง Ultra Search
    if #nodes == 0 then
        warn("⚠️ Deep Search ไม่เจอ → เปลี่ยนเป็น Ultra Search")
        SearchStats.searchMode = "ULTRA"
        nodes = ultraSearchNodes()
    end
    
    -- บันทึกสถิติ
    SearchStats.totalSearches = SearchStats.totalSearches + 1
    SearchStats.treesFound = #nodes
    SearchStats.lastSearchTime = tick()
    
    return nodes
end

--// 📏 ฟังก์ชันหาต้นไม้ใกล้สุดพร้อมการจัดอันดับ
local function getClosestAliveNode()
    local nodeList = smartSearchNodes()
    
    if #nodeList == 0 then
        warn("❌ ไม่พบต้นไม้เลย! (" .. SearchStats.searchMode .. " mode)")
        return nil
    end
    
    -- 📊 จัดอันดับต้นไม้ตามระยะทางและ HP
    local rankedNodes = {}
    for _, node in pairs(nodeList) do
        local dist = (hrp.Position - node.Position).Magnitude
        local health = node:FindFirstChild("Health") and node.Health.Value or 0
        local priority = dist - (health * 0.1) -- ยิ่งใกล้และ HP สูง = ลำดับดี
        
        table.insert(rankedNodes, {
            node = node,
            distance = dist,
            health = health,
            priority = priority
        })
    end
    
    -- เรียงจากลำดับความสำคัญ
    table.sort(rankedNodes, function(a, b)
        return a.priority < b.priority
    end)
    
    local best = rankedNodes[1]
    print(("🎯 เลือกต้นไม้: %s | ระยะทาง: %.1f | HP: %d | โหมด: %s")
        :format(best.node.Name, best.distance, best.health, SearchStats.searchMode))
    
    return best.node
end

--// 📡 ฟังก์ชันสแกนพื้นที่รอบตัวแบบ 360 องศา
local function scanArea360()
    local foundNodes = {}
    local scanPoints = 16 -- จำนวนจุดสแกน
    local scanRadius = 300
    
    print("📡 เริ่มสแกน 360 องศา รัศมี " .. scanRadius .. " studs...")
    
    for i = 1, scanPoints do
        local angle = (360 / scanPoints) * i
        local radians = math.rad(angle)
        
        local offsetX = math.cos(radians) * scanRadius
        local offsetZ = math.sin(radians) * scanRadius
        local scanPos = hrp.Position + Vector3.new(offsetX, 0, offsetZ)
        
        -- หาต้นไม้ที่ใกล้จุดสแกน
        local nodeList = smartSearchNodes()
        for _, node in pairs(nodeList) do
            local dist = (node.Position - scanPos).Magnitude
            if dist <= 100 then
                table.insert(foundNodes, node)
            end
        end
    end
    
    print(("📡 สแกนเสร็จ: พบต้นไม้ %d ต้น"):format(#foundNodes))
    return foundNodes
end

--// 🗺️ ฟังก์ชันสร้างแผนที่ต้นไม้ (Tree Map)
local function createTreeMap()
    local treeMap = {}
    local allNodes = smartSearchNodes()
    
    for _, node in pairs(allNodes) do
        local pos = node.Position
        local key = string.format("%.0f_%.0f_%.0f", pos.X, pos.Y, pos.Z)
        
        treeMap[key] = {
            object = node,
            position = pos,
            health = node:FindFirstChild("Health") and node.Health.Value or 0,
            lastChecked = tick()
        }
    end
    
    print(("🗺️ สร้างแผนที่ต้นไม้: %d ตำแหน่ง"):format(#allNodes))
    return treeMap
end

--// 🎮 ฟังก์ชันควบคุมโหมดค้นหา
local function setSearchMode(mode)
    if mode == "NORMAL" or mode == "DEEP" or mode == "ULTRA" then
        SearchStats.searchMode = mode
        print("✅ เปลี่ยนโหมดค้นหาเป็น: " .. mode)
    else
        warn("❌ โหมดไม่ถูกต้อง! ใช้ได้เฉพาะ NORMAL, DEEP, ULTRA")
    end


--// 🚀 ระบบค้นหาอัตโนมัติแบบเข้มข้น (เปลี่ยนจาก startAutoFarm เดิม)
local function startAdvancedAutoFarm()
    task.spawn(function()
        local retryCount = 0
        local lastTreePos = nil
        local stuckCounter = 0
        
        while true do
            local node = getClosestAliveNode()

            if node and node:FindFirstChild("Health") and node.Health.Value > 0 then
                retryCount = 0
                
                -- ตรวจสอบว่าติดที่ต้นไม้เดิมไหม
                if lastTreePos and (node.Position - lastTreePos).Magnitude < 5 then
                    stuckCounter = stuckCounter + 1
                    if stuckCounter >= 3 then
                        warn("⚠️ ติดต้นไม้เดิม → ค้นหาต้นใหม่")
                        setSearchMode("ULTRA")
                        stuckCounter = 0
                    end
                else
                    stuckCounter = 0
                    lastTreePos = node.Position
                end

                print("🌳 พบต้นไม้:", node.Name, "| HP:", node.Health.Value)
                hrp.CFrame = node.CFrame + Vector3.new(0, 4, 0)
                spamAttack(node)

            else
                retryCount += 1
                warn(("⚠️ ไม่พบต้นไม้รอบที่ %d → ลอง %s mode"):format(retryCount, SearchStats.searchMode))
                
                -- เปลี่ยนโหมดค้นหาตามจำนวนครั้งที่ไม่เจอ
                if retryCount >= 3 and SearchStats.searchMode == "NORMAL" then
                    setSearchMode("DEEP")
                elseif retryCount >= 5 and SearchStats.searchMode == "DEEP" then
                    setSearchMode("ULTRA")
                elseif retryCount >= 8 then
                    warn("🚶 ใช้โหมด Patrol เนื่องจากค้นหาไม่เจอนานเกินไป")
                    
                    -- ลองสแกน 360 องศาก่อน
                    local scannedNodes = scanArea360()
                    if #scannedNodes > 0 then
                        local randomNode = scannedNodes[math.random(1, #scannedNodes)]
                        hrp.CFrame = randomNode.CFrame + Vector3.new(0, 4, 0)
                        print("✅ พบต้นไม้จากการสแกน 360°")
                    else
                        -- ใช้ Patrol แบบเดิม
                        for _, pos in ipairs(PATROL_POSITIONS) do
                            hrp.CFrame = CFrame.new(pos)
                            task.wait(CONFIG.MOVEMENT_SPEED)

                            local foundNode = getClosestAliveNode()
                            if foundNode then
                                print("🌲 เจอต้นไม้ตอน patrol:", foundNode.Name)
                                hrp.CFrame = foundNode.CFrame + Vector3.new(0, 4, 0)
                                spamAttack(foundNode)
                                break
                            end
                        end
                    end
                    
                    -- รีเซ็ตค่า
                    retryCount = 0
                    setSearchMode("NORMAL")
                end
                
                task.wait(2)
            end

            task.wait(1)
            
            -- แสดงสถิติทุก 30 วิ
            if SearchStats.totalSearches % 30 == 0 then
                printSearchStats()
            end
        end
    end)
end


